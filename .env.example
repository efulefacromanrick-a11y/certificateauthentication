# Copy from .env.local on the Vercel dashboard
# https://nextjs.org/learn/dashboard-app/setting-up-your-database#create-a-postgres-database
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

CERT_SECRET=replace-with-a-long-random-signing-secret
CERT_ADMIN_TOKEN=replace-with-a-long-random-api-token
SEED_TOKEN=replace-with-a-separate-bootstrap-token

# `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-auth-secret
AUTH_URL=http://localhost:4000/api/auth

# Local-only OTP delivery fallback. Never enable this in production.
REGISTRATION_OTP_DEBUG=true

# Optional production Ed25519 issuer keys (base64-encoded DER).
CERT_PRIVATE_KEY=
CERT_PUBLIC_KEY=
REGISTRATION_OTP_REQUIRED=true
